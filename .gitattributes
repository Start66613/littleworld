# Little World: binary assets must never be normalised or line-converted.
*.lwr  binary
*.lwp  binary
*.lwfa binary
*.lwpx binary
*.rgb565a8 binary
*.png  binary
*.webp binary
*.gif  binary
*.bmp  binary
*.bin  binary
# Source and docs stay LF regardless of core.autocrlf on the build machine, so
# a Windows checkout cannot flip line endings and dirty a clean worktree.
*.c    text eol=lf
*.h    text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.ps1  text eol=lf
*.py   text eol=lf
# Content files are byte-counted against a 32 KB limit and the device reads them
# as-is, so a CRLF checkout would change the size the parser sees. Keep them LF.
*.lwcx text eol=lf