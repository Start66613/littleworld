# Build output
/build/
/firmware/build/
/build_v3.log
/windows_regression.log
/tools/*.log

# ESP-IDF generated files
/firmware/sdkconfig
/firmware/sdkconfig.old
/firmware/sdkconfig.legacy
/firmware/sdkconfig.noaudio
/firmware/managed_components/
/firmware/dependencies.lock

# Local tools (fonts are fetched, not vendored)
/tools/fonts/node_modules/
/tools/fonts/cache/
/tools/fonts/package-lock.json

# Logs and simulator intermediate images
/reports/logs/*.log
/reports/logs/v41/
/reports/logs/v41-*.txt
/reports/screenshots/*.bmp

# Night Runner runtime output: per-run logs, locks, task jsonl and summaries.
# The plan itself (tools/nightly/night_plan.json) IS tracked; its scratch output
# is not, otherwise every run would dirty the worktree and trip the very drift
# check the runner uses to prove a task did not damage the repo.
/logs/nightly/
/reports/nightly/

# Never commit firmware images, dumps or private material
*.bin
*.elf
*.map

# Local-only state, credentials and art production material
/private/
/secrets/
.env
.env.*
!.env.example
**/.state/
**/LittleWorld-data/
/reports/ui-v2/**/*.bmp
/build-ui-v2/
__pycache__/
*.lwpx
*.rgb565a8
/reports/ui-v2/os-v2/
/reports/ui-v2/os-v2-fallback/
/reports/ui-v2/os-v3/
/reports/ui-v2/os-v3-fallback/
/reports/ui-v2/os-v3-legacy/
/reports/os-v2/screens/
/reports/ui-v2/v4-*/
/assets/visual-v4/generated/
/build_os.log
/build_other.log/build_other*.log
/build_*.log
/commitmsg.txt
# V4 diagnostics / flash run output (per-run logs and captures)
/reports/logs/flash/
/reports/logs/v4/
/reports/diagnostics/

# V4.4 perf evidence: the 5 idf.py build logs are ~660 KB of toolchain chatter
# and add nothing the build_matrix.json does not already record (bytes, sha256,
# effective symbols, pass/fail). The soak and probe logs ARE kept - they are the
# only evidence behind the 30-minute stress result and the desktop dual-state
# finding in reports/perf-v4-4/.
/reports/logs/v44/build-*.log

# Content: the committed sample is deliberately not personal. Real memories go
# in content/private/ (or anywhere outside the repo) and must never be pushed.
/content/private/
/content/*.local.lwcx

# Release assembly output: rebuilt on demand by tools/package_v4_3_release.ps1.
# Only dist/littleworld-v4-sd (the verified SD package) is committed.
/dist/release-v4-3/

/reports/ui-v2/v42-*/
/assets/visual-v4-2/generated/
/reports/logs/meowa-skill-review/
/reports/logs/v42-custom-workflow-catalog.json
/reports/visual-v4-2/preflight/
/reports/visual-v4-2/contact-review/
/reports/visual-v4-2/scale-review/
/reports/visual-v4-2/interface-check/
/reports/visual-v4-2/meowa-first/
/reports/visual-v4-2/meowa-second/
/reports/ui-v2/v43-*/

# Private card build (contains the private qianqian-base.lwp; never publish)
/dist/littleworld-v4-sd-private/

/reports/board/*.bmp
/reports/board-v43/
/reports/board/*.png
/COMMIT_MSG_V45.txt
/COMMIT_MSG_V45B.txt
/COMMIT_MSG_V45C.txt
